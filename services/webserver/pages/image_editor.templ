package pages

import (
	"personal-website/services/webserver/components"
	"personal-website/services/webserver/layouts"
	"personal-website/services/webserver/static"
)

type ImageEditor struct{}

const editorButtonClass = "flex min-h-11 min-w-11 items-center justify-center gap-2xs px-2xs py-2xs font-mono text-s cursor-pointer text-content hover:bg-lightblue hover:text-blue focus-visible:outline-2 disabled:bg-transparent disabled:text-content disabled:opacity-40 disabled:cursor-not-allowed @min-[56rem]:min-h-0 @min-[56rem]:min-w-0 @min-[56rem]:justify-start @min-[72rem]:px-3xs"

const editorToggleButtonClass = editorButtonClass + " aria-pressed:bg-blue aria-pressed:text-base aria-pressed:hover:bg-darkblue aria-pressed:hover:text-base"

const editorIconButtonClass = editorButtonClass + " @min-[56rem]:size-8 @min-[56rem]:justify-center @min-[56rem]:gap-0 @min-[56rem]:px-0"

const editorIconToggleButtonClass = editorIconButtonClass + " aria-pressed:bg-blue aria-pressed:text-base aria-pressed:hover:bg-darkblue aria-pressed:hover:text-base"

const editorToolButtonClass = editorToggleButtonClass

const editorButtonLabelClass = "sr-only @min-[56rem]:not-sr-only"

const editorGroupLabelClass = "hidden w-[5.25rem] shrink-0 self-stretch items-start gap-2xs border-e border-content/15 pe-xs pt-2xs font-mono text-[0.5625rem] uppercase tracking-[0.18em] leading-none text-content/50 @min-[56rem]:flex"

const editorControlGroupClass = "min-w-0 flex-wrap items-center gap-2xs border-t border-content/30 px-2xs py-2xs @min-[56rem]:first:border-t-0 @min-[56rem]:items-stretch"

const editorContextGroupClass = "hidden min-w-0 flex-wrap items-center gap-2xs border-t border-content/30 px-2xs py-2xs data-[active=true]:flex @min-[56rem]:h-full @min-[56rem]:items-stretch"

const editorControlButtonsClass = "flex min-w-0 grow basis-[min(18rem,100%)] flex-wrap items-center gap-3xs"

const editorControlSideClass = "flex min-w-0 flex-wrap items-center gap-3xs"

const editorControlTrailingClass = "ms-auto flex min-w-0 flex-wrap items-center gap-3xs"

const editorNumberInputClass = "h-7 w-14 border-0 border-b border-content/25 bg-transparent px-3xs text-right font-mono text-s tabular-nums text-content focus:border-blue focus:outline-none disabled:opacity-35"

const editorLayerActionClass = "flex size-11 items-center justify-center p-2xs font-mono text-s cursor-pointer text-content/60 hover:bg-lightblue hover:text-blue focus-visible:outline-2 disabled:bg-transparent disabled:text-content disabled:opacity-30 disabled:cursor-not-allowed @min-[36rem]:size-10 @min-[56rem]:size-8"

templ (p ImageEditor) View() {
	@layouts.Base{
		Title:       "Ethan Thoma / Image Editor",
		Description: "Start on a blank canvas, paste images directly onto it, select and move them, sketch or draw annotation lines, select regions with a magic wand, and fill them. Everything stays in your browser.",
		URL:         "/tools/image-editor",
	}.View() {
		<article
			id="image-editor-root"
			class="row-start-1 col-[2/-2]"
			data-interactive="false"
			data-worker-url={ static.Asset("js/image-editor-selection-worker.js") }
		>
			@components.PageHeader{
				Title: "Image editor",
				Breadcrumbs: []components.Breadcrumb{
					{Label: "Home", Href: "/home", HasFragment: true},
					{Label: "Tools", Href: "/tools", HasFragment: true},
				},
				Tagline: "Local and private",
			}.View() {
				<p>
					Start with a blank canvas, then paste or drop images directly onto it. Select and move pasted images,
					sketch with the pencil or draw straight annotation lines, select regions with the magic wand, and fill them.
					Everything stays in your browser.
				</p>
			}
			<section class="mt-l @container" aria-label="Image editor">
				<div class="flex flex-col @min-[56rem]:block">
					<div id="editor-toolbar" data-dock-visible="true" class="fixed inset-x-[var(--spacing-xs-xl)] bottom-2xs z-20 translate-y-[calc(100%+var(--spacing-2xs))] border border-content/30 bg-base opacity-0 shadow-2xl transition-[translate,opacity] duration-200 ease-out data-[dock-visible=true]:translate-y-0 data-[dock-visible=true]:opacity-100 @min-[56rem]:static @min-[56rem]:translate-y-0 @min-[56rem]:border-x-0 @min-[56rem]:border-t-0 @min-[56rem]:bg-transparent @min-[56rem]:opacity-100 @min-[56rem]:shadow-none">
						<div class="grid @min-[72rem]:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
							<div class={ editorControlGroupClass + " order-2 flex @min-[56rem]:order-none @min-[72rem]:border-e" } role="group" aria-label="Image actions">
								@editorGroupLabel("01", "Image")
								<div class={ editorControlButtonsClass }>
									<div class={ editorControlSideClass }>
										<button id="editor-paste" type="button" class={ editorButtonClass }>
											@editorIcon("paste")
											<span class={ editorButtonLabelClass }>Paste</span>
										</button>
										<label class={ editorButtonClass + " focus-within:border-blue focus-within:text-blue focus-within:outline-2 focus-within:outline-blue" }>
											@editorIcon("image-plus")
											<span class={ editorButtonLabelClass }>Add images</span>
											<input id="editor-file" type="file" accept="image/*" multiple class="sr-only"/>
										</label>
									</div>
									<div class={ editorControlTrailingClass }>
										<button id="editor-copy" type="button" aria-label="Copy canvas" title="Copy canvas" disabled class={ editorButtonClass }>
											@editorIcon("copy")
											<span id="editor-copy-label" class={ editorButtonLabelClass }>Copy canvas</span>
										</button>
									</div>
								</div>
							</div>
							<div class={ editorControlGroupClass + " order-1 flex @min-[56rem]:order-none" } role="group" aria-label="Editor tools and history">
								@editorGroupLabel("02", "Tools")
								<div class={ editorControlButtonsClass }>
									<div class={ editorControlSideClass } role="group" aria-label="Editor tool">
										<button id="editor-tool-select" type="button" data-editor-tool="select" aria-pressed="true" class={ editorToolButtonClass }>
											@editorIcon("cursor")
											<span class={ editorButtonLabelClass }>Select</span>
										</button>
										<button id="editor-tool-pencil" type="button" data-editor-tool="pencil" aria-pressed="false" class={ editorToolButtonClass }>
											@editorIcon("pencil")
											<span class={ editorButtonLabelClass }>Pencil</span>
										</button>
										<button id="editor-tool-line" type="button" data-editor-tool="line" aria-pressed="false" class={ editorToolButtonClass }>
											@editorIcon("line")
											<span class={ editorButtonLabelClass }>Line</span>
										</button>
										<button id="editor-tool-wand" type="button" data-editor-tool="wand" aria-pressed="false" class={ editorToolButtonClass }>
											@editorIcon("wand")
											<span class={ editorButtonLabelClass }>Magic wand</span>
										</button>
									</div>
									<div class={ editorControlTrailingClass }>
										<button id="editor-undo" type="button" disabled class={ editorButtonClass }>
											@editorIcon("undo")
											<span class={ editorButtonLabelClass }>Undo</span>
										</button>
										<button id="editor-clear" type="button" disabled class={ editorButtonClass }>
											@editorIcon("eraser")
											<span class={ editorButtonLabelClass }>Clear ink</span>
										</button>
									</div>
								</div>
							</div>
							<div id="editor-context-row" class="order-3 min-w-0 @min-[56rem]:h-[4.25rem]">
								<div id="editor-select-group" data-active="true" class={ editorContextGroupClass } role="group" aria-label="Select controls">
									@editorGroupLabel("03", "Select")
									<div class={ editorControlButtonsClass }>
										<div class={ editorControlSideClass + " @min-[56rem]:flex-nowrap" }>
											<label class="flex items-center gap-3xs font-mono text-[0.625rem] uppercase tracking-[0.12em] text-content/55">
												<span>X</span>
												<input id="editor-select-x" type="number" step="1" disabled aria-label="Image X position" class={ editorNumberInputClass }/>
											</label>
											<label class="flex items-center gap-3xs font-mono text-[0.625rem] uppercase tracking-[0.12em] text-content/55">
												<span>Y</span>
												<input id="editor-select-y" type="number" step="1" disabled aria-label="Image Y position" class={ editorNumberInputClass }/>
											</label>
											<label class="flex items-center gap-3xs font-mono text-[0.625rem] uppercase tracking-[0.12em] text-content/55">
												<span>W</span>
												<input id="editor-select-width" type="number" min="24" step="1" disabled aria-label="Image width" class={ editorNumberInputClass }/>
											</label>
											<label class="flex items-center gap-3xs font-mono text-[0.625rem] uppercase tracking-[0.12em] text-content/55">
												<span>H</span>
												<input id="editor-select-height" type="number" min="24" step="1" disabled aria-label="Image height" class={ editorNumberInputClass }/>
											</label>
											<button id="editor-select-aspect" type="button" aria-label="Lock aspect ratio" title="Lock aspect ratio" aria-pressed="false" disabled class={ editorIconToggleButtonClass }>
												@editorIcon("link")
											</button>
										</div>
										<div class={ editorControlSideClass + " @min-[56rem]:border-s @min-[56rem]:border-content/15 @min-[56rem]:ps-xs" }>
											<button id="editor-select-center" type="button" aria-label="Center image on canvas" title="Center image on canvas" disabled class={ editorIconButtonClass }>
												@editorIcon("center")
											</button>
											<button id="editor-select-fit" type="button" aria-label="Fit image to canvas" title="Fit image to canvas" disabled class={ editorIconButtonClass }>
												@editorIcon("fit")
											</button>
											<button id="editor-select-flip-horizontal" type="button" aria-label="Flip image horizontally" title="Flip horizontal" disabled class={ editorIconButtonClass }>
												@editorIcon("flip-horizontal")
											</button>
											<button id="editor-select-flip-vertical" type="button" aria-label="Flip image vertically" title="Flip vertical" disabled class={ editorIconButtonClass }>
												@editorIcon("flip-vertical")
											</button>
											<button id="editor-select-reset-aspect" type="button" aria-label="Restore the image's source aspect ratio" title="Restore source ratio" disabled class={ editorIconButtonClass }>
												@editorIcon("aspect")
											</button>
										</div>
										<p id="editor-select-summary" class="hidden min-w-0 grow font-mono text-[0.625rem] leading-tight text-content/45 @min-[72rem]:block">Paste or draw on a layer.</p>
									</div>
								</div>
								<div id="editor-ink-group" data-active="false" class={ editorContextGroupClass } role="group" aria-label="Ink controls">
									@editorGroupLabel("03", "Ink")
									<div class={ editorControlButtonsClass }>
										<div class={ editorControlSideClass }>
											<div id="editor-color-control" class="relative">
												<button id="editor-color-toggle" type="button" aria-expanded="false" aria-controls="editor-color-popover" class={ editorButtonClass + " aria-expanded:border-blue aria-expanded:text-blue" }>
													<canvas id="editor-color-swatch" width="32" height="32" aria-hidden="true" class="h-4 w-4 shrink-0 border border-content/20"></canvas>
													<span class={ editorButtonLabelClass }>Ink colour</span>
												</button>
												<input id="editor-color" type="hidden" value="#f96b06"/>
												<div id="editor-color-popover" hidden class="absolute bottom-full left-0 z-20 mb-2xs w-72 max-w-[calc(100vw_-_2rem)] border border-content/30 bg-base p-xs font-mono text-s text-content @min-[56rem]:bottom-auto @min-[56rem]:top-full @min-[56rem]:mb-0 @min-[56rem]:mt-2xs">
													<div class="flex items-center justify-between gap-xs">
														<span class="flex items-center gap-2xs">
															@editorIcon("palette")
															Ink colour
														</span>
														<button id="editor-color-done" type="button" class="flex items-center gap-2xs px-2xs py-3xs font-mono cursor-pointer text-content hover:bg-lightblue hover:text-blue focus-visible:outline-2">
															@editorIcon("check")
															Done
														</button>
													</div>
													<canvas id="editor-color-plane" width="240" height="120" tabindex="0" aria-label="Saturation and brightness. Use the arrow keys to adjust." class="mt-xs block aspect-[2/1] w-full touch-none cursor-crosshair"></canvas>
													<canvas id="editor-color-hue" width="240" height="16" tabindex="0" role="slider" aria-label="Hue" aria-valuemin="0" aria-valuemax="360" aria-valuenow="25" class="mt-2xs block h-4 w-full touch-none cursor-ew-resize"></canvas>
													<label class="mt-xs flex items-center gap-2xs">
														<span class="text-[0.625rem] uppercase tracking-[0.14em] text-content/60">Hex</span>
														<input id="editor-color-hex" type="text" value="#F96B06" maxlength="7" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Hex colour" class="min-w-0 flex-1 px-2xs py-3xs font-mono uppercase bg-transparent border-0 border-b border-content/30 text-content focus:border-blue focus:outline-none aria-invalid:border-orange aria-invalid:text-orange"/>
													</label>
													<div class="mt-xs grid grid-cols-6 gap-2xs" role="group" aria-label="Colour presets">
														<button type="button" data-editor-color="#141413" aria-label="Black" title="Black" aria-pressed="false" class="h-6 w-6 cursor-pointer border border-content/20 bg-content hover:border-blue focus-visible:border-blue aria-pressed:outline-2 aria-pressed:outline-offset-2 aria-pressed:outline-blue"></button>
														<button type="button" data-editor-color="#ffffff" aria-label="White" title="White" aria-pressed="false" class="h-6 w-6 cursor-pointer border border-content/20 bg-white hover:border-blue focus-visible:border-blue aria-pressed:outline-2 aria-pressed:outline-offset-2 aria-pressed:outline-blue"></button>
														<button type="button" data-editor-color="#f96b06" aria-label="Orange" title="Orange" aria-pressed="true" class="h-6 w-6 cursor-pointer border border-content/20 bg-orange hover:border-blue focus-visible:border-blue aria-pressed:outline-2 aria-pressed:outline-offset-2 aria-pressed:outline-blue"></button>
														<button type="button" data-editor-color="#fab505" aria-label="Gold" title="Gold" aria-pressed="false" class="h-6 w-6 cursor-pointer border border-content/20 bg-gold hover:border-blue focus-visible:border-blue aria-pressed:outline-2 aria-pressed:outline-offset-2 aria-pressed:outline-blue"></button>
														<button type="button" data-editor-color="#0064e6" aria-label="Blue" title="Blue" aria-pressed="false" class="h-6 w-6 cursor-pointer border border-content/20 bg-blue hover:border-blue focus-visible:border-blue aria-pressed:outline-2 aria-pressed:outline-offset-2 aria-pressed:outline-blue"></button>
														<button type="button" data-editor-color="#0052c2" aria-label="Dark blue" title="Dark blue" aria-pressed="false" class="h-6 w-6 cursor-pointer border border-content/20 bg-darkblue hover:border-blue focus-visible:border-blue aria-pressed:outline-2 aria-pressed:outline-offset-2 aria-pressed:outline-blue"></button>
													</div>
												</div>
											</div>
										</div>
										<div class={ editorControlTrailingClass }>
											<label class="flex items-center gap-2xs px-2xs py-2xs font-mono text-s text-content/60">
												@editorIcon("weight")
												<span class={ editorButtonLabelClass }>Width</span>
												<input id="editor-width" type="range" min="1" max="24" value="4" step="1" class="editor-range w-24"/>
												<output id="editor-width-value" class="min-w-[3.25rem] font-mono tabular-nums text-content">4 px</output>
											</label>
										</div>
									</div>
								</div>
								<div id="editor-scan-group" data-active="false" class={ editorContextGroupClass } role="group" aria-label="Magic wand controls">
									@editorGroupLabel("03", "Scan")
									<div class={ editorControlButtonsClass }>
										<div class={ editorControlSideClass }>
											<label class="flex items-center gap-2xs px-2xs py-2xs font-mono text-s text-content/60">
												@editorIcon("target")
												<span class={ editorButtonLabelClass }>Tolerance</span>
												<input id="editor-tolerance" type="range" min="0" max="100" value="12" step="1" class="editor-range w-24"/>
												<output id="editor-tolerance-value" class="min-w-[2.75rem] font-mono tabular-nums text-content">12%</output>
											</label>
											<label class="flex items-center gap-2xs px-2xs py-2xs font-mono text-s text-content/60">
												@editorIcon("contiguous")
												<input id="editor-contiguous" type="checkbox" checked class="accent-blue cursor-pointer"/>
												<span class={ editorButtonLabelClass }>Contiguous</span>
											</label>
										</div>
										<div class={ editorControlTrailingClass }>
											<button id="editor-fill" type="button" aria-label="Fill selection" title="Fill selection" disabled class={ editorButtonClass }>
												@editorIcon("fill")
												<span class={ editorButtonLabelClass }>Fill</span>
											</button>
											<button id="editor-clear-selection" type="button" aria-label="Clear selection" title="Clear selection" disabled class={ editorButtonClass }>
												@editorIcon("deselect")
												<span class={ editorButtonLabelClass }>Clear</span>
											</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div id="editor-workspace" class="order-1 border-x border-b border-content/30 @min-[56rem]:order-none">
						<div class="grid">
							<div id="editor-statusbar" class="order-2 flex flex-wrap items-center gap-x-s gap-y-3xs bg-content px-xs py-3xs font-mono text-[0.625rem] uppercase tracking-[0.14em] text-base/55 @min-[56rem]:order-1">
								<span class="flex items-center gap-2xs">Mode <span id="editor-mode-readout" class="text-base">Select</span></span>
								<span class="flex items-center gap-2xs">Frame <span id="editor-frame-readout" class="text-base">1280 × 720</span></span>
								<span class="hidden items-center gap-2xs @min-[36rem]:flex">Layer <span id="editor-layer-readout" class="max-w-32 truncate text-base">—</span></span>
								<span class="hidden items-center gap-2xs @min-[30rem]:flex">Cursor <span id="editor-cursor-readout" class="min-w-[6.75rem] tabular-nums text-base">---- / ----</span></span>
								<span class="hidden items-center gap-2xs @min-[30rem]:flex">History <span id="editor-history-readout" class="tabular-nums text-base">00</span></span>
								<span class="ms-auto flex items-center gap-2xs"><span class="h-1.5 w-1.5 bg-orange" aria-hidden="true"></span>Local session</span>
							</div>
							<div class="order-1 min-w-0 @min-[56rem]:order-2">
								<div id="editor-drop-zone" class="relative aspect-video w-full overflow-hidden bg-white">
									<canvas id="editor-canvas" width="1280" height="720" class="block h-full w-full touch-none cursor-crosshair select-none bg-white" aria-label="Canvas for image edits and annotation lines"></canvas>
									<span aria-hidden="true" class="pointer-events-none absolute left-2xs top-2xs h-3 w-3 border-s border-t border-orange/80"></span>
									<span aria-hidden="true" class="pointer-events-none absolute right-2xs top-2xs h-3 w-3 border-e border-t border-orange/80"></span>
									<span aria-hidden="true" class="pointer-events-none absolute bottom-2xs left-2xs h-3 w-3 border-b border-s border-orange/80"></span>
									<span aria-hidden="true" class="pointer-events-none absolute bottom-2xs right-2xs h-3 w-3 border-b border-e border-orange/80"></span>
								</div>
								<div class="flex items-center gap-2xs border-t border-content/15 bg-content/[0.02] px-xs py-2xs">
									<span class="h-1.5 w-1.5 shrink-0 bg-orange" aria-hidden="true"></span>
									<p id="editor-status" class="min-w-0 font-mono text-s leading-tight text-content/55" role="status" aria-live="polite">Preparing a blank canvas…</p>
								</div>
							</div>
							<section id="editor-layers" class="order-3 min-w-0 border-t border-content/30 bg-base" aria-labelledby="editor-layers-heading">
								<div class="flex items-center gap-2xs border-b border-content/15 px-3xs py-2xs @min-[36rem]:px-xs">
									<h2 id="editor-layers-heading" class="flex items-center gap-2xs font-mono text-[0.625rem] uppercase tracking-[0.15em] leading-none text-content/65">
										@editorIcon("layers")
										<span>Layers</span>
									</h2>
									<span id="editor-layer-count" class="font-mono text-[0.625rem] tabular-nums text-content/45">00</span>
									<span class="hidden font-mono text-[0.625rem] uppercase tracking-[0.12em] text-content/35 @min-[36rem]:inline">Front → back</span>
									<div class="ms-auto flex items-center gap-0 @min-[36rem]:gap-3xs" role="group" aria-label="Layer actions">
										<button id="editor-layer-new" type="button" aria-label="Add ink layer" title="Add ink layer" class={ editorLayerActionClass }>
											@editorIcon("layer-plus")
										</button>
										<button id="editor-layer-forward" type="button" aria-label="Bring layer forward, toward the left" title="Bring forward (left)" disabled class={ editorLayerActionClass }>
											@editorIcon("arrow-left")
										</button>
										<button id="editor-layer-backward" type="button" aria-label="Send layer backward, toward the right" title="Send backward (right)" disabled class={ editorLayerActionClass }>
											@editorIcon("arrow-right")
										</button>
										<button id="editor-layer-duplicate" type="button" aria-label="Duplicate layer" title="Duplicate layer" disabled class={ editorLayerActionClass }>
											@editorIcon("copy")
										</button>
										<button id="editor-layer-delete" type="button" aria-label="Delete layer" title="Delete layer" disabled class={ editorLayerActionClass }>
											@editorIcon("trash")
										</button>
									</div>
								</div>
								<template id="editor-layer-row-template">
									<li data-selected="false" class="flex h-16 w-52 shrink-0 snap-start border border-content/20 bg-base data-[selected=true]:border-blue data-[selected=true]:bg-lightblue">
										<button type="button" data-layer-action="visibility" class="flex min-w-11 shrink-0 items-center justify-center border-e border-content/15 text-content/45 cursor-pointer hover:bg-lightblue hover:text-blue focus-visible:outline-2">
											<span data-layer-visibility-on>
												@editorIcon("eye")
											</span>
											<span data-layer-visibility-off hidden>
												@editorIcon("eye-off")
											</span>
										</button>
										<button type="button" data-layer-action="select" aria-pressed="false" class="flex min-w-0 grow items-center gap-2xs p-2xs text-left cursor-pointer hover:bg-lightblue focus-visible:outline-2">
											<canvas data-layer-thumbnail width="56" height="36" class="h-9 w-14 shrink-0 border border-content/20 bg-white" aria-hidden="true"></canvas>
											<span class="min-w-0">
												<span data-layer-name class="block truncate font-mono text-s leading-tight text-content"></span>
												<span data-layer-meta class="block truncate font-mono text-[0.625rem] uppercase tracking-[0.12em] text-content/45"></span>
											</span>
										</button>
									</li>
								</template>
								<template id="editor-layer-empty-template">
									<li class="flex h-16 min-w-0 grow items-center justify-center gap-2xs border border-dashed border-content/20 px-s text-center font-mono text-s leading-tight text-content/45">
										<span class="text-content/35">
											@editorIcon("layers")
										</span>
										<span>Paste an image or draw to start a stack.</span>
									</li>
								</template>
								<ul id="editor-layer-list" class="flex gap-2xs overflow-x-auto px-xs py-2xs [scrollbar-color:var(--color-content)_transparent] [scrollbar-width:thin]" aria-label="Layers, front to back"></ul>
							</section>
						</div>
					</div>
				</div>
			</section>
			@templ.Raw("<script>" + layouts.ImageEditorJS + "</script>")
		</article>
	}
}

templ editorGroupLabel(index string, text string) {
	<span class={ editorGroupLabelClass }>
		<span class="tabular-nums text-orange/80" aria-hidden="true">{ index }</span>
		<span>{ text }</span>
	</span>
}

templ editorIcon(name string) {
	switch name {
		case "paste":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<rect x="6" y="5" width="12" height="16"></rect>
				<path d="M9 5V3h6v2"></path>
				<path d="M12 9v7M9 13l3 3 3-3"></path>
			</svg>
		case "image-plus":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<rect x="3" y="5" width="13" height="14"></rect>
				<path d="M3 15l4-4 3 3 2-2 4 4"></path>
				<circle cx="8" cy="9" r="1"></circle>
				<path d="M19 3v8M15 7h8"></path>
			</svg>
		case "copy":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<rect x="8" y="8" width="12" height="12"></rect>
				<path d="M16 8V4H4v12h4"></path>
			</svg>
		case "cursor":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M5 3l14 9-6 1-3 6z"></path>
			</svg>
		case "pencil":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M4 20l1-5L16 4l4 4L9 19z"></path>
				<path d="M14 6l4 4"></path>
			</svg>
		case "line":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<rect x="3" y="17" width="4" height="4"></rect>
				<rect x="17" y="3" width="4" height="4"></rect>
				<path d="M7 17L17 7"></path>
			</svg>
		case "wand":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M4 20L15 9"></path>
				<path d="M13 3l1 3 3 1-3 1-1 3-1-3-3-1 3-1z"></path>
				<path d="M19 14v4M17 16h4"></path>
			</svg>
		case "undo":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M9 6L4 11l5 5"></path>
				<path d="M4 11h9a6 6 0 0 1 0 12h-2"></path>
			</svg>
		case "eraser":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M4 16l9-9 5 5-7 7H8z"></path>
				<path d="M13 7l4 4"></path>
				<path d="M6 20h14"></path>
			</svg>
		case "palette":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<rect x="4" y="5" width="16" height="14"></rect>
				<path d="M8 5v14M12 5v14M16 5v14"></path>
			</svg>
		case "check":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M5 12l4 4L19 6"></path>
			</svg>
		case "weight":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M4 6h16" stroke-width="1"></path>
				<path d="M4 12h16" stroke-width="2"></path>
				<path d="M4 18h16" stroke-width="4"></path>
			</svg>
		case "target":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<circle cx="12" cy="12" r="8"></circle>
				<circle cx="12" cy="12" r="3"></circle>
				<path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
			</svg>
		case "contiguous":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<rect x="3" y="7" width="7" height="10"></rect>
				<rect x="14" y="7" width="7" height="10"></rect>
				<path d="M10 12h4"></path>
			</svg>
		case "fill":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M4 12l7-7 8 8-7 7H8z"></path>
				<path d="M8 8l8 8"></path>
				<path d="M20 15c0 1.1-.9 2-2 2s-2-.9-2-2 2-3 2-3 2 1.9 2 3z"></path>
			</svg>
		case "layers":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M12 3L3 8l9 5 9-5-9-5z"></path>
				<path d="M3 12l9 5 9-5"></path>
				<path d="M3 16l9 5 9-5"></path>
			</svg>
		case "eye":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>
				<circle cx="12" cy="12" r="2.5"></circle>
			</svg>
		case "eye-off":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M3 3l18 18"></path>
				<path d="M10.6 6.2A10.8 10.8 0 0 1 12 6c6.5 0 10 6 10 6a17.4 17.4 0 0 1-3 3.6"></path>
				<path d="M6.2 6.2C3.5 8 2 12 2 12s3.5 6 10 6c1.4 0 2.7-.3 3.8-.8"></path>
			</svg>
		case "arrow-left":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M19 12H5M11 6l-6 6 6 6"></path>
			</svg>
		case "arrow-right":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M5 12h14M13 6l6 6-6 6"></path>
			</svg>
		case "layer-plus":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M12 3L3 8l9 5 9-5-9-5z"></path>
				<path d="M3 12l9 5 9-5"></path>
				<path d="M19 16v6M16 19h6"></path>
			</svg>
		case "center":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M12 3v18M3 12h18"></path>
				<rect x="8" y="8" width="8" height="8"></rect>
			</svg>
		case "fit":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"></path>
				<rect x="8" y="8" width="8" height="8"></rect>
			</svg>
		case "link":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M9 15l6-6"></path>
				<path d="M7.5 10.5l-2 2a3.5 3.5 0 0 0 5 5l2-2"></path>
				<path d="M16.5 13.5l2-2a3.5 3.5 0 0 0-5-5l-2 2"></path>
			</svg>
		case "flip-horizontal":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M12 3v18"></path>
				<path d="M9 6L4 12l5 6V6z"></path>
				<path d="M15 6l5 6-5 6V6z" stroke-dasharray="2 2"></path>
			</svg>
		case "flip-vertical":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M3 12h18"></path>
				<path d="M6 9l6-5 6 5H6z"></path>
				<path d="M6 15l6 5 6-5H6z" stroke-dasharray="2 2"></path>
			</svg>
		case "aspect":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M5 9V5h4M15 5h4v4M19 15v4h-4M9 19H5v-4"></path>
				<path d="M9 15l6-6"></path>
				<rect x="8" y="8" width="8" height="8" stroke-dasharray="2 2"></rect>
			</svg>
		case "trash":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<path d="M4 7h16"></path>
				<path d="M9 3h6l1 4H8l1-4z"></path>
				<path d="M6 7l1 14h10l1-14"></path>
				<path d="M10 11v6M14 11v6"></path>
			</svg>
		case "deselect":
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
				<rect x="4" y="4" width="16" height="16" stroke-dasharray="3 3"></rect>
				<path d="M9 9l6 6M15 9l-6 6"></path>
			</svg>
	}
}
